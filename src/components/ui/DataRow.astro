---
/**
 * DataRow — banda blanca «etiqueta + valor» de la tarjeta de evento (p.7).
 *
 * La etiqueta va en Arial con tracking sobre la banda blanca y el valor
 * en Segoe UI; el par va centrado en la banda —vertical y
 * horizontalmente— y se apila debajo cuando la composición es estrecha.
 *
 * Medidas de la p.7 a escala 1:1: banda de 60px de alto, con 31px de
 * padding lateral; etiqueta a 16px de Arial Bold y valor a 21.33px de
 * Segoe UI. La banda no llega al borde de la tarjeta: la sangra el `<dl>`
 * de `EventCard` 31px a cada lado, para acabar a la misma altura que los
 * separadores de la lista de competencias del bloque de abajo.
 *
 * **Tenía una variante `navy`** para la tarjeta del home, que desapareció
 * con `NextEvent` (D-153).
 *
 * En el lienzo el padding lateral baja a 1.25 u. El par va centrado, así
 * que a 1920 no se mueve un píxel; pero la etiqueta no baja de 11px (por
 * legibilidad) y por debajo de ~1440 deja de encoger con la escala: a
 * 1280 «UBICACIÓN» + «Lake Charles, Louisiana» pedían 244px y el padding
 * del diseño sólo dejaba 241. La etiqueta además no puede partirse: la
 * regla global `overflow-wrap: anywhere` la cortaba en «UBICACIÓ / N».
 */
interface Props {
    label: string;
    value: string;
    /** HTML extra si el valor contiene elementos (p. ej. un enlace). */
    valueHtml?: string;
}

const { label, value, valueHtml } = Astro.props;
---

<div
    class="event-data-row flex flex-col items-center justify-center gap-1 bg-white px-[1.9375em] text-center sm:flex-row sm:gap-4 canvas:px-[1.25em]"
>
    <dt class="eyebrow t-label shrink-0 whitespace-nowrap text-navy-700">{label}</dt>
    <dd class="event-data-value text-chrome-ink">
        {valueHtml ? <Fragment set:html={valueHtml} /> : value}
    </dd>
</div>
