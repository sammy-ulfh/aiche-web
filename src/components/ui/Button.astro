---
/**
 * Button — enlace o botón con tres variantes.
 *
 * Variantes:
 *  - "primary": navy sólido, texto blanco. CTAs principales.
 *  - "secondary": fondo crema, texto navy, borde navy. Sobre fondo navy.
 *  - "ghost": transparente, texto navy/subrayado. Sobre fondo claro.
 *
 * `href` → renderiza `<a>`. Sin `href` → renderiza `<button>`.
 */
interface Props {
    href?: string;
    variant?: 'primary' | 'secondary' | 'ghost';
    size?: 'sm' | 'md' | 'lg';
    class?: string;
    ariaLabel?: string;
    type?: 'button' | 'submit' | 'reset';
}

const {
    href,
    variant = 'primary',
    size = 'md',
    class: className = '',
    ariaLabel,
    type = 'button',
} = Astro.props;

const base =
    'inline-flex items-center justify-center font-semibold uppercase tracking-wider transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy-400';

const variants = {
    primary: 'bg-navy text-white hover:bg-navy-900',
    secondary: 'bg-cream text-navy border border-navy hover:bg-white',
    ghost: 'bg-transparent text-navy underline-offset-4 hover:underline',
} as const;

const sizes = {
    sm: 'px-4 py-2 text-xs',
    md: 'px-5 py-3 text-sm',
    lg: 'px-6 py-4 text-base',
} as const;

const cls = [base, variants[variant], sizes[size], className];
---

{
    href ? (
        <a href={href} class:list={cls} aria-label={ariaLabel}>
            <slot />
        </a>
    ) : (
        <button type={type} class:list={cls} aria-label={ariaLabel}>
            <slot />
        </button>
    )
}
